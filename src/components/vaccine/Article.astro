---
// The vaccine's text, with a booking card that stays in view beside it.
import Icon from '../Icon.astro';
import { BOOKING, CONTACT, type Lang } from '../../data/site';
import type { VaccineCopy } from '../../data/vaccine';

interface Props {
  body: string;
  source: { label: string; href?: string } | null;
  copy: VaccineCopy;
  lang: Lang;
}

const { body, source, copy, lang } = Astro.props;
---

<section class="gsv-section article">
  <div class="gsv-container article__grid">
    <div class="article__body">
      {
        body && (
          <>
            <span class="gsv-eyebrow">{copy.about.eyebrow}</span>
            <h2 class="gsv-h2 article__title">{copy.about.title}</h2>
            <div class="prose" set:html={body} />
          </>
        )
      }
      {
        source && (
          <p class="article__source">
            {copy.source} {source.href ? <a href={source.href}>{source.label}</a> : source.label}
          </p>
        )
      }
    </div>
    <aside class="article__card">
      <h2>{copy.card.title}</h2>
      <a class="gsv-button" href={BOOKING}>{copy.card.button}<Icon name="arrow-right" /></a>
      <dl class="article__contact">
        <div>
          <dt>{copy.card.call}</dt>
          <dd><a href={`tel:+1${CONTACT.phone.replaceAll('-', '')}`}>{CONTACT.phone}</a></dd>
        </div>
        <div>
          <dt>{copy.card.hours}</dt>
          <dd>{CONTACT.hours[lang]}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .article__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    align-items: start;
    gap: 80px;
  }
  .article__title {
    margin-bottom: 28px;
  }
  .prose {
    max-width: 68ch;
    font-size: 17px;
    line-height: 1.75;
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 1.8em;
    color: var(--gsv-primary);
    font: 600 21px/1.35 var(--gsv-font-sans);
    letter-spacing: -0.02em;
  }
  .prose :global(strong) {
    color: var(--gsv-primary);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--gsv-primary);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--gsv-primary-l-5);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--gsv-primary);
  }
  .prose :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 30px;
  }
  .prose :global(li)::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--gsv-secondary-l-4);
    box-shadow: 0 0 0 4px var(--gsv-primary-l-6);
  }
  .prose :global(img) {
    border-radius: 16px;
  }
  .article__source a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .article__source {
    max-width: 68ch;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--gsv-border-subtle);
    color: var(--gsv-text-muted);
    font-size: 14px;
  }
  .article__card {
    position: sticky;
    top: calc(var(--gsv-header-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    border: 1px solid var(--gsv-border-subtle);
    border-radius: 24px;
    background:
      radial-gradient(at 100% 0%, rgba(255, 255, 255, 0.8) 0%, transparent 60%),
      linear-gradient(160deg, var(--gsv-primary-l-6), var(--gsv-secondary-l-5));
  }
  .article__card h2 {
    color: var(--gsv-primary);
    font: 500 26px/1.2 var(--gsv-font-serif);
    letter-spacing: -0.02em;
  }
  .article__card p {
    font-size: 15px;
    line-height: 1.6;
  }
  .article__card .gsv-button {
    margin-top: 8px;
  }
  .article__contact {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 8px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--gsv-border-subtle);
  }
  .article__contact dt {
    color: var(--gsv-text-muted);
    font-size: 13px;
  }
  .article__contact dd {
    margin: 2px 0 0;
    color: var(--gsv-primary);
    font-size: 15px;
    font-weight: 600;
  }
  .article__contact a {
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .article__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .article__card {
      position: static;
      max-width: 560px;
    }
  }
  @media (max-width: 767px) {
    .prose {
      font-size: 16px;
    }
    .article__card {
      padding: 24px;
    }
  }
</style>
