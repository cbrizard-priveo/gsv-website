---
// Three numbered booking steps, after Priveo's booking steps.
import Icon from '../Icon.astro';
import { BOOKING } from '../../data/site';
import type { VaccineCopy } from '../../data/vaccine';

interface Props {
  copy: VaccineCopy;
}

const { copy } = Astro.props;
---

<section class="gsv-section steps">
  <div class="gsv-container">
    <header class="gsv-section-header">
      <span class="gsv-eyebrow">{copy.steps.eyebrow}</span>
      <h2 class="gsv-h2">{copy.steps.title}</h2>
      <p class="gsv-lede">{copy.steps.text}</p>
    </header>
    <ol class="steps__list">
      {
        copy.steps.items.map((step, i) => (
          <li>
            <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
    <div class="steps__cta">
      <a class="gsv-button" href={BOOKING}>{copy.book}<Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .steps {
    background: var(--gsv-white);
  }
  .steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps__list li {
    padding-top: 28px;
    border-top: 1px solid var(--gsv-border-subtle);
  }
  .steps__num {
    display: block;
    margin-bottom: 18px;
    color: var(--gsv-secondary);
    font: 500 28px/1 var(--gsv-font-serif);
  }
  .steps__list h3 {
    margin-bottom: 10px;
    color: var(--gsv-primary);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .steps__list p {
    line-height: 1.65;
  }
  .steps__cta {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  @media (max-width: 767px) {
    .steps__list {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
