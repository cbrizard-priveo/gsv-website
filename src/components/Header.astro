---
// Site header: Priveo's (web-priveo-sante, site/src/components/layout/Header.astro) with this site's menu.
// The markup, class names, ids and data attributes are Priveo's and must stay so: its styles and scripts,
// synced by scripts/design/sync-priveo.mjs, hook onto them. Classes added here also go in that script's list.
import '../styles/tokens.css';
import '../styles/priveo/header.css';
import '../styles/header.css';
import { BOOKING, menus, type Dropdown, type Item, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  /** Same page in the other language, for the FR/EN switcher. */
  alt: string | null;
  /** Current route, to mark the active menu item. */
  route: string;
}

const { lang, alt, route } = Astro.props;
const menu = menus[lang];
const home = lang === 'fr' ? '/' : '/en/';
const other = lang === 'fr' ? { code: 'EN', name: 'English', lang: 'en' } : { code: 'FR', name: 'Français', lang: 'fr' };
const altHref = alt ?? (lang === 'fr' ? '/en/' : '/');
const isDropdown = (item: Item): item is Dropdown => 'links' in item;
const current = (href: string) => (href === route ? 'page' : undefined);

// Priveo's styles address its first three dropdowns by these ids; a fourth takes the defaults, as on its site.
const DROPDOWN_IDS = [
  { li: '', script: 'vfoxgc', content: 'rrzhea', menu: 'jgxisu' },
  { li: 'dsyywj', script: 'dsyywj', content: 'eslzdw', menu: 'jueqzb' },
  { li: 'acbiak', script: 'acbiak', content: 'xrcgca', menu: 'kkoqyg' },
];
const NODE_LAYOUTS: Record<string, string> = {
  acbiak: 'header__dropdown-layout',
  dsyywj: 'header__dropdown-layout-2',
  eslzdw: 'header__dropdown-content-layout',
  rrzhea: 'header__dropdown-content-layout-2',
  xrcgca: 'header__dropdown-content-layout-3',
};
const node = (id: string) => (id ? `layout-node-${id}` : undefined);
// A group titled like its menu item is hidden on mobile, where the item's label already heads the list.
const sameLabel = (a: string, b: string) => a.trim().toLocaleLowerCase(lang) === b.trim().toLocaleLowerCase(lang);

const lastIndex = menu.items.length - 1;
let dropdown = -1;
---

<div id="site-header" class="ui-sticky">
  <header id="header__inner" class="layout-element layout-section header">
    <div class="layout-element layout-container header__container">
      <a href={home} aria-current={current(home)} class="layout-element layout-box header__logo">
        <img
          class="layout-element media-vector"
          src="/wp-content/uploads/2021/11/voyage-6-300x171.png"
          srcset="/wp-content/uploads/2021/11/voyage-6-300x171.png 300w, /wp-content/uploads/2021/11/voyage-6-768x439.png 768w"
          sizes="140px"
          alt="Groupe Santé Voyage, propulsé par Priveo"
          width="300"
          height="171"
        />
      </a>
      <div class="layout-element layout-box header__nav">
        <nav id="layout-node-aseiog" data-script-id="aseiog" class="layout-element header__menu-layout navigation header__menu" aria-label={menu.menu} data-toggle="laptop">
          <ul class="layout-element layout-stack header__items navigation__items">
            {
              menu.items.map((item, i) => {
                const closeToggle = i === lastIndex && menu.items.length > 1 && (
                  <li class="navigation__item">
                    <button data-script-id="hdskss" class="layout-element navigation__toggle header__toggle navigation__toggle-icon" aria-label={menu.closeMenu} aria-expanded="false">
                      <span class="toggle-animation-wrap">
                        <span class="toggle-animation-inner" />
                      </span>
                    </button>
                  </li>
                );
                if (!isDropdown(item)) {
                  return (
                    <>
                      {closeToggle}
                      <li class="navigation__item">
                        <a class="layout-element action-link header__nav-link" href={item.href} aria-current={current(item.href)}>
                          {item.label}
                        </a>
                      </li>
                    </>
                  );
                }
                dropdown += 1;
                const ids = DROPDOWN_IDS[dropdown] ?? { li: '', script: `dd${dropdown}`, content: '', menu: '' };
                return (
                  <>
                    {closeToggle}
                    <li id={node(ids.li)} data-script-id={ids.script} class:list={['layout-element', NODE_LAYOUTS[ids.li], 'navigation__dropdown header__dropdown']} data-toggle="both">
                      <div class="navigation__submenu-toggle">
                        <span>{item.label}</span>
                        <button aria-expanded="false" aria-label={`${menu.submenu} ${item.label}`}>
                          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none">
                            <path d="M1.50002 4L6.00002 8L10.5 4" stroke-width="1.5" stroke="currentcolor" />
                          </svg>
                        </button>
                      </div>
                      <ul id={node(ids.content)} class:list={['layout-element', NODE_LAYOUTS[ids.content], 'layout-box header__dropdown-content navigation__submenu']}>
                        <li class="navigation__item">
                          <div class="layout-box header__dropdown-grid header__panel header__panel--2">
                            <div class="layout-element layout-box header__dropdown-column">
                              <p class:list={['layout-element typography-heading header__dropdown-title', { 'header__dropdown-title--redundant': sameLabel(item.group, item.label) }]}>{item.group}</p>
                              <div id={node(ids.menu)} class="layout-element navigation__link-group header__nav-menu">
                                <nav class="ui-nav-menu-wrapper never" aria-label={item.group}>
                                  <ul class="navigation__links">
                                    {item.links.map((link) => (
                                      <li class="navigation__item ui-menu-item">
                                        <a href={link.href} aria-current={current(link.href)}>
                                          {link.label}
                                        </a>
                                      </li>
                                    ))}
                                  </ul>
                                </nav>
                              </div>
                            </div>
                            <div class="layout-element layout-box header__dropdown-column header__panel-intro">
                              <p class="layout-element typography-heading header__dropdown-title header__panel-title">{item.intro.title}</p>
                              <a class="header__panel-link" href={item.intro.cta.href}>
                                {item.intro.cta.label}
                                <i aria-hidden="true">
                                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" width="1em" height="1em" fill="none">
                                    <path d="M1 6h10M7 2l4 4-4 4" stroke="currentcolor" stroke-width="1.5" />
                                  </svg>
                                </i>
                              </a>
                            </div>
                          </div>
                        </li>
                      </ul>
                    </li>
                  </>
                );
              })
            }
          </ul>
          <button data-script-id="aboapx" class="layout-element navigation__toggle header__toggle navigation__toggle--squeeze" aria-label={menu.openMenu} aria-expanded="false">
            <span class="toggle-animation-wrap">
              <span class="toggle-animation-inner"></span>
            </span>
          </button>
        </nav>
      </div>
      <div class="layout-element layout-box header__actions" data-breakin="1200">
        <div id="layout-node-sypygv" class="layout-element header__lang-layout embedded-widget header__lang">
          <a class="header__language-link" href={altHref} hreflang={other.lang} lang={other.lang} aria-label={other.name} title={other.name}>{other.code}</a>
        </div>
        <a id="layout-node-jztazb" class="layout-element header__action-link-layout action-link btn btn--primary" href={BOOKING}>{menu.book}</a>
      </div>
    </div>
  </header>
</div>
<div class="gsv-header-space"></div>

<script is:inline src="/assets/priveo/header.js" defer></script>
