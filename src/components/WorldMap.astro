---
// Interactive world map for the country hub. Drawn at build time (d3-geo + world-atlas), so the page
// ships a plain SVG: each country with a page is a link; a little script adds the name tooltip and the
// zoom by region. Small islands also get a dot so they can be clicked.
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import type { Feature, FeatureCollection, Geometry, MultiPolygon, Polygon, Position } from 'geojson';
import world110 from 'world-atlas/countries-110m.json';
import world50 from 'world-atlas/countries-50m.json';
import type { Lang } from '../data/site';
import { REGIONS, countries, countryPath, type RegionId } from '../lib/countries';
import { MAP_PARTS } from '../data/country-map';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = {
  fr: {
    label: 'Carte du monde : pays ayant une page de recommandations',
    hint: 'Cliquez sur un pays pour voir les vaccins et les risques recommandés par l’INSPQ.',
    world: 'Monde',
    zoom: 'Afficher une région',
    covered: 'Pays avec une page de recommandations',
    other: 'Autres pays',
  },
  en: {
    label: 'World map: countries with a recommendations page',
    hint: 'Click a country to see the vaccines and risks recommended by the INSPQ.',
    world: 'World',
    zoom: 'Show a region',
    covered: 'Countries with a recommendations page',
    other: 'Other countries',
  },
}[lang];

type Topo = Parameters<typeof feature>[0];
const toFeatures = (topo: unknown) =>
  (feature(topo as Topo, (topo as { objects: { countries: never } }).objects.countries) as unknown as FeatureCollection<Geometry, { name: string }>).features;
const background = toFeatures(world110).filter((f) => f.id !== '010'); // without Antarctica
const detailed = new Map(toFeatures(world50).map((f) => [String(f.id), f]));
const byName = new Map([...detailed.values()].map((f) => [f.properties.name.toLowerCase(), String(f.id)]));

const W = 1000;
const projection = geoNaturalEarth1().fitWidth(W, { type: 'FeatureCollection', features: background } as FeatureCollection);
const path = geoPath(projection).digits(1);
const [[, top], [, bottom]] = path.bounds({ type: 'FeatureCollection', features: background } as FeatureCollection);
const H = Math.ceil(bottom - top);
projection.translate([projection.translate()[0], projection.translate()[1] - top]);

// Keep only the polygons of a (multi)polygon that fall inside a box.
const inBox = (ring: Position[], [w, s, e, n]: number[]) => ring.every(([x, y]) => x >= w && x <= e && y >= s && y <= n);
function clip(f: Feature<Geometry>, box?: [number, number, number, number]): Feature<Geometry> | null {
  if (!box) return f;
  const g = f.geometry as Polygon | MultiPolygon;
  const polys = g.type === 'Polygon' ? [g.coordinates] : g.coordinates;
  const kept = polys.filter((p) => inBox(p[0], box));
  return kept.length ? { ...f, geometry: { type: 'MultiPolygon', coordinates: kept } } : null;
}

const shapes = countries.flatMap((c) => {
  const parts = MAP_PARTS[c.slug] ?? [{ id: byName.get(c.name.en.toLowerCase()) ?? '' }];
  const geos = parts.map((p) => detailed.get(p.id) && clip(detailed.get(p.id)!, p.box)).filter((f): f is Feature<Geometry> => !!f);
  if (!geos.length) return [];
  const fc = { type: 'FeatureCollection', features: geos } as FeatureCollection;
  const [[x0, y0], [x1, y1]] = path.bounds(fc);
  const area = geos.reduce((sum, g) => sum + path.area(g), 0);
  const [cx, cy] = path.centroid(fc);
  // Tiny islands are hard to hit: give them a dot.
  const dot = area < 40 && Number.isFinite(cx) ? { cx: +cx.toFixed(1), cy: +cy.toFixed(1), area: +area.toFixed(2) } : null;
  return [{ country: c, d: geos.map((g) => path(g)).join(''), bounds: [x0, y0, x1, y1], dot }];
});
const covered = new Set(shapes.flatMap((s) => (MAP_PARTS[s.country.slug] ?? [{ id: byName.get(s.country.name.en.toLowerCase()) }]).filter((p) => !p.box).map((p) => p.id)));
const others = background.filter((f) => !covered.has(String(f.id))).map((f) => path(f)).filter(Boolean);

// One view box per region (with some margin), for the zoom buttons.
const regionViews = REGIONS.map((r) => {
  const b = shapes.filter((s) => s.country.region === r.id).map((s) => s.bounds);
  if (!b.length) return null;
  const pad = 24;
  let x0 = Math.min(...b.map((v) => v[0])) - pad;
  let y0 = Math.min(...b.map((v) => v[1])) - pad;
  let w = Math.max(...b.map((v) => v[2])) + pad - x0;
  let h = Math.max(...b.map((v) => v[3])) + pad - y0;
  // Keep the map's proportions so the region fills the frame.
  if (w / h > W / H) {
    const nh = (w * H) / W;
    y0 -= (nh - h) / 2;
    h = nh;
  } else {
    const nw = (h * W) / H;
    x0 -= (nw - w) / 2;
    w = nw;
  }
  return { id: r.id as RegionId, name: r.name[lang], view: [x0, y0, w, h].map((v) => +v.toFixed(1)).join(' ') };
}).filter((r) => r !== null);
---

<div class="world-map" data-world-map>
  <div class="world-map__bar">
    <p class="world-map__hint">{t.hint}</p>
    <div class="world-map__zoom" role="group" aria-label={t.zoom}>
      <button type="button" data-view={`0 0 ${W} ${H}`} aria-pressed="true">{t.world}</button>
      {regionViews.map((r) => <button type="button" data-view={r.view} data-region={r.id} aria-pressed="false">{r.name}</button>)}
    </div>
  </div>
  <div class="world-map__frame">
    <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={t.label} data-base-width={W}>
      <g class="world-map__others" aria-hidden="true">
        {others.map((d) => <path d={d} />)}
      </g>
      <g class="world-map__countries">
        {
          shapes.map((s) => (
            <a href={countryPath(s.country, lang)} class="world-map__country" data-name={s.country.name[lang]} data-region={s.country.region} aria-label={s.country.name[lang]}>
              <path d={s.d} />
              {s.dot && <circle class="world-map__dot" cx={s.dot.cx} cy={s.dot.cy} r="3.5" data-area={s.dot.area} />}
            </a>
          ))
        }
      </g>
    </svg>
    <div class="world-map__tip" role="presentation" hidden></div>
  </div>
  <ul class="world-map__legend">
    <li><span class="world-map__swatch world-map__swatch--covered"></span>{t.covered}</li>
    <li><span class="world-map__swatch"></span>{t.other}</li>
  </ul>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-world-map]')) {
    const svg = root.querySelector('svg')!;
    const frame = root.querySelector<HTMLElement>('.world-map__frame')!;
    const tip = root.querySelector<HTMLElement>('.world-map__tip')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const dots = [...svg.querySelectorAll<SVGCircleElement>('.world-map__dot')];
    const baseWidth = Number(svg.dataset.baseWidth);
    const parse = (v: string) => v.split(' ').map(Number);
    let current = parse(svg.getAttribute('viewBox')!);
    let frameId = 0;

    // Dots keep the same size on screen when zoomed in, and disappear once the island itself is big
    // enough to click.
    const setView = (v: number[]) => {
      current = v;
      svg.setAttribute('viewBox', v.join(' '));
      const scale = baseWidth / v[2];
      const r = String(3.5 / scale);
      for (const dot of dots) dot.style.display = Number(dot.dataset.area) * scale * scale < 40 ? '' : 'none';
      for (const dot of dots) dot.setAttribute('r', r);
    };

    const zoomTo = (target: number[]) => {
      cancelAnimationFrame(frameId);
      if (reduceMotion) return setView(target);
      const from = current;
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min((now - start) / 450, 1);
        const e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
        setView(from.map((f, i) => f + (target[i] - f) * e));
        if (k < 1) frameId = requestAnimationFrame(step);
      };
      frameId = requestAnimationFrame(step);
    };

    for (const b of buttons) {
      b.addEventListener('click', () => {
        for (const o of buttons) o.setAttribute('aria-pressed', String(o === b));
        root.dataset.region = b.dataset.region ?? '';
        zoomTo(parse(b.dataset.view!));
      });
    }

    // Name tooltip, for the mouse and for keyboard focus.
    const show = (el: Element, x: number, y: number) => {
      tip.textContent = (el as HTMLElement).dataset.name ?? '';
      tip.hidden = false;
      const box = frame.getBoundingClientRect();
      tip.style.left = `${Math.min(Math.max(x - box.left, 60), box.width - 60)}px`;
      tip.style.top = `${y - box.top}px`;
    };
    svg.addEventListener('pointermove', (e) => {
      const link = (e.target as Element).closest('.world-map__country');
      if (link) show(link, e.clientX, e.clientY);
      else tip.hidden = true;
    });
    svg.addEventListener('pointerleave', () => (tip.hidden = true));
    svg.addEventListener('focusin', (e) => {
      const link = (e.target as Element).closest('.world-map__country');
      if (!link) return;
      const r = link.getBoundingClientRect();
      show(link, r.left + r.width / 2, r.top);
    });
    svg.addEventListener('focusout', () => (tip.hidden = true));
  }
</script>

<style>
  .world-map {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .world-map__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .world-map__hint {
    color: var(--gsv-text-muted);
    font-size: 15px;
  }
  .world-map__zoom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .world-map__zoom button {
    padding: 8px 14px;
    border: 1px solid var(--gsv-border-subtle);
    border-radius: var(--gsv-radius-full);
    background: var(--gsv-white);
    color: var(--gsv-primary);
    font: 500 14px/1.2 var(--gsv-font-sans);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .world-map__zoom button:hover {
    border-color: var(--gsv-secondary-l-4);
    background: var(--gsv-primary-l-6);
  }
  .world-map__zoom button[aria-pressed='true'] {
    border-color: var(--gsv-primary);
    background: var(--gsv-primary);
    color: var(--gsv-white);
  }
  .world-map__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--gsv-border-subtle);
    border-radius: 20px;
    background: var(--gsv-primary-l-6);
  }
  .world-map svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .world-map svg path {
    stroke: var(--gsv-white);
    stroke-width: 0.6;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .world-map__others path {
    fill: #d5dbe3;
  }
  .world-map__country path,
  .world-map__dot {
    fill: var(--gsv-secondary);
    transition: fill 0.15s;
  }
  .world-map__dot {
    stroke: var(--gsv-white);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .world-map__country:hover path,
  .world-map__country:hover .world-map__dot,
  .world-map__country:focus-visible path,
  .world-map__country:focus-visible .world-map__dot {
    fill: var(--gsv-primary-d-2);
  }
  .world-map__country:focus-visible {
    outline: none;
  }
  /* When a region is shown, the other regions' countries fade back. */
  .world-map[data-region='amerique-centrale'] .world-map__country:not([data-region='amerique-centrale']) path,
  .world-map[data-region='amerique-du-sud'] .world-map__country:not([data-region='amerique-du-sud']) path,
  .world-map[data-region='caraibes'] .world-map__country:not([data-region='caraibes']) path,
  .world-map[data-region='afrique'] .world-map__country:not([data-region='afrique']) path,
  .world-map[data-region='asie-du-sud-est'] .world-map__country:not([data-region='asie-du-sud-est']) path {
    fill: #9fbbe0;
  }
  .world-map__tip {
    position: absolute;
    z-index: 1;
    padding: 6px 12px;
    border-radius: 10px;
    background: var(--gsv-primary-d-2);
    color: var(--gsv-white);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
  }
  .world-map__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    color: var(--gsv-text-muted);
    font-size: 14px;
    list-style: none;
  }
  .world-map__legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .world-map__swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: #d5dbe3;
  }
  .world-map__swatch--covered {
    background: var(--gsv-secondary);
  }

  @media (max-width: 767px) {
    .world-map__zoom button {
      padding: 7px 12px;
      font-size: 13px;
    }
  }
</style>
