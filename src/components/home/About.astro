---
// Image and text side by side, after Priveo's feature split.
import Icon from '../Icon.astro';
import type { HomeContent } from '../../data/home';

interface Props {
  content: HomeContent['about'];
}

const { content } = Astro.props;
---

<section class="gsv-section about">
  <div class="gsv-container about__grid">
    <figure class="about__media">
      <img src={content.image} alt="" loading="lazy" width="625" height="400" />
    </figure>
    <div class="about__text">
      <span class="gsv-eyebrow">{content.eyebrow}</span>
      <h2 class="gsv-h2">{content.title} <em>{content.titleEm}</em></h2>
      {content.paragraphs.map((p) => <p class="gsv-lede" set:html={p} />)}
      <a class="gsv-button gsv-button--outline" href={content.cta.href}>{content.cta.label}<Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .about {
    padding-top: 40px;
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 80px;
  }
  .about__media {
    position: relative;
  }
  .about__media::before {
    content: '';
    position: absolute;
    inset: 32px -24px -24px 32px;
    z-index: -1;
    border-radius: 28px;
    background: var(--gsv-secondary-l-5);
  }
  .about__media img {
    width: 100%;
    aspect-ratio: 5 / 4;
    border-radius: 24px;
    object-fit: cover;
  }
  .about__text .gsv-lede :global(a) {
    color: var(--gsv-primary);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--gsv-primary-l-5);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  .about__text .gsv-lede :global(a:hover) {
    text-decoration-color: var(--gsv-primary);
  }
  .about__text .gsv-button {
    margin-top: 32px;
  }

  @media (max-width: 1024px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .about__media {
      max-width: 560px;
    }
  }
</style>
