---
// Review cards in a scrolling row with arrow buttons, after Priveo's testimonials.
import Icon from '../Icon.astro';
import type { HomeContent } from '../../data/home';

interface Props {
  content: HomeContent['testimonials'];
}

const { content } = Astro.props;
---

<section class="gsv-section testimonials">
  <div class="gsv-container">
    <header class="gsv-section-header">
      <span class="gsv-eyebrow">{content.eyebrow}</span>
      <h2 class="gsv-h2">{content.title}</h2>
    </header>
  </div>
  <div class="testimonials__track" data-track tabindex="0">
    {
      content.items.map((item) => (
        <figure class="testimonials__card">
          <span class="testimonials__stars" aria-label="5/5">
            ★★★★★
          </span>
          <blockquote>{item.quote}</blockquote>
          <figcaption>
            <span class="testimonials__avatar" aria-hidden="true">
              {item.name[0]}
            </span>
            <span>
              <strong>{item.name}</strong>
              {item.role}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
  <div class="gsv-container testimonials__controls">
    <button type="button" data-dir="-1" aria-label={content.previous}><Icon name="arrow-left" /></button>
    <button type="button" data-dir="1" aria-label={content.next}><Icon name="arrow-right" /></button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.testimonials').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    section.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((button) => {
      button.addEventListener('click', () => {
        const card = track.firstElementChild as HTMLElement;
        track.scrollBy({ left: Number(button.dataset.dir) * (card.offsetWidth + 24), behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  .testimonials {
    background: linear-gradient(180deg, var(--gsv-surface-l-4) 0%, var(--gsv-primary-l-6) 100%);
  }
  .testimonials__track {
    display: flex;
    gap: 24px;
    padding: 8px max(40px, calc((100vw - 1240px) / 2)) 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(40px, calc((100vw - 1240px) / 2));
    scrollbar-width: none;
  }
  .testimonials__track::-webkit-scrollbar {
    display: none;
  }
  .testimonials__track:focus-visible {
    outline: 2px solid var(--gsv-secondary);
    outline-offset: -2px;
  }
  .testimonials__card {
    display: flex;
    flex: 0 0 380px;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border-radius: 20px;
    background: var(--gsv-white);
    box-shadow: 0 1px 2px rgba(27, 30, 44, 0.04), 0 12px 32px -20px rgba(1, 42, 86, 0.25);
    scroll-snap-align: start;
  }
  .testimonials__stars {
    color: var(--gsv-warning);
    font-size: 17px;
    letter-spacing: 2px;
  }
  .testimonials__card blockquote {
    flex-grow: 1;
    font-size: 15px;
    line-height: 1.65;
  }
  .testimonials__card figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13.5px;
    line-height: 1.35;
  }
  .testimonials__card figcaption strong {
    display: block;
    color: var(--gsv-primary);
    font-size: 14.5px;
    font-weight: 600;
  }
  .testimonials__avatar {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--gsv-secondary);
    color: var(--gsv-white);
    font-weight: 600;
  }
  .testimonials__controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }
  .testimonials__controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--gsv-border-subtle);
    border-radius: 50%;
    background: var(--gsv-white);
    color: var(--gsv-primary);
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .testimonials__controls button:hover {
    border-color: var(--gsv-primary-l-5);
    background: var(--gsv-primary-l-6);
  }
  .testimonials__controls :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 767px) {
    .testimonials__track {
      padding-inline: 20px;
      scroll-padding-inline: 20px;
    }
    .testimonials__card {
      flex-basis: 84vw;
    }
  }
</style>
