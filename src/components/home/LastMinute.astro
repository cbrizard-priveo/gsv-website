---
// « Départ de dernière minute ? » band: a photo of travellers at a gate, a short message and the booking
// button. Photo: Unsplash 8GtcwJNGncY (Unsplash licence: free for commercial use), downloaded 2026-11-13.
import Icon from '../Icon.astro';
import { BOOKING, type Lang } from '../../data/site';
import { lastMinute } from '../../data/home-tools';

interface Props {
  lang: Lang;
}

const t = lastMinute[Astro.props.lang];
---

<section class="last-minute">
  <div class="gsv-container">
    <div class="last-minute__box">
      <img class="last-minute__photo" src="/images/home/derniere-minute.jpg" alt="" width="960" height="640" loading="lazy" decoding="async" />
      <div class="last-minute__body">
        <h2 class="last-minute__title">{t.title}</h2>
        <p class="last-minute__text">{t.text}</p>
      </div>
      <a class="gsv-button gsv-button--light last-minute__cta" href={BOOKING} target="_blank" rel="noopener">{t.cta}<Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .last-minute {
    padding-block: 0 80px;
  }
  .last-minute__box {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px;
    padding: 16px 44px 16px 16px;
    border-radius: 20px;
    background: var(--gsv-primary);
    color: var(--gsv-white);
  }
  .last-minute__photo {
    width: 100%;
    height: 170px;
    border-radius: 12px;
    object-fit: cover;
  }
  .last-minute__title {
    color: var(--gsv-white);
    font: 500 clamp(24px, 2.4vw, 32px) / 1.15 var(--gsv-font-serif);
    letter-spacing: -0.5px;
  }
  .last-minute__text {
    margin-top: 8px;
    max-width: 60ch;
    line-height: 1.6;
  }
  .last-minute__cta {
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .last-minute__box {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      padding: 16px 16px 28px;
    }
    .last-minute__photo {
      height: 160px;
    }
    .last-minute__body {
      padding-inline: 8px;
    }
    .last-minute__cta {
      margin-inline: 8px;
    }
    .last-minute__cta {
      justify-self: start;
    }
  }
</style>
