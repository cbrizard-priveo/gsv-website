---
// Title on the left, advantages with round icon badges on the right, after Priveo's points band.
import Icon from '../Icon.astro';
import type { HomeContent } from '../../data/home';

interface Props {
  content: HomeContent['points'];
}

const { content } = Astro.props;
---

<section class="gsv-section points">
  <div class="gsv-container points__panel">
    <header class="points__header">
      <span class="gsv-eyebrow">{content.eyebrow}</span>
      <h2 class="gsv-h2">{content.title}</h2>
      <a class="gsv-button" href={content.cta.href}>{content.cta.label}<Icon name="arrow-right" /></a>
    </header>
    <ul class="points__items">
      {
        content.items.map((item) => (
          <li class="points__item">
            <span class="points__icon">
              <Icon name={item.icon} />
            </span>
            <p class="points__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .points__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 80px;
    align-items: start;
  }
  .points__header {
    position: sticky;
    top: calc(var(--gsv-header-height) + 32px);
  }
  .points__header .gsv-button {
    margin-top: 32px;
  }
  .points__items {
    display: flex;
    flex-direction: column;
  }
  .points__item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding: 32px 0;
    border-top: 1px solid var(--gsv-border-subtle);
  }
  .points__item:first-child {
    padding-top: 8px;
    border-top: 0;
  }
  .points__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--gsv-secondary-l-4);
    color: var(--gsv-primary);
  }
  .points__icon :global(svg) {
    width: 28px;
    height: 28px;
  }
  .points__item {
    align-items: center;
  }
  .points__text {
    font-size: 17px;
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .points__panel {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .points__header {
      position: static;
    }
  }
  @media (max-width: 767px) {
    .points__item {
      grid-template-columns: 52px 1fr;
      gap: 18px;
    }
    .points__icon {
      width: 52px;
      height: 52px;
    }
    .points__icon :global(svg) {
      width: 24px;
      height: 24px;
    }
  }
</style>
