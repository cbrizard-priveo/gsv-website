---
// « Une seule clinique, peu importe la destination »: the slogan over a strip of travel settings.
// One row of photos at every width (no links, no captions), then the button to the destinations.
import Icon from '../Icon.astro';
import type { Lang } from '../../data/site';
import { destinations } from '../../data/home-tools';

interface Props {
  lang: Lang;
}

const t = destinations[Astro.props.lang];
---

<section class="gsv-section dest">
  <div class="gsv-container">
    <div class="gsv-section-header">
      <h2 class="gsv-h2">{t.title}</h2>
      <p class="gsv-lede">{t.text}</p>
    </div>
    <ul class="dest__tiles">
      {
        t.tiles.map((tile) => (
          <li class="dest__tile">
            <img src={tile.image} alt={tile.label} loading="lazy" decoding="async" width="640" height="427" />
          </li>
        ))
      }
    </ul>
    <p class="dest__cta">
      <a class="gsv-button" href={t.cta.href}>{t.cta.label}<Icon name="arrow-right" /></a>
    </p>
  </div>
</section>

<style>
  .dest {
    padding-block: 72px;
  }
  .dest .gsv-section-header {
    margin-bottom: 32px;
  }
  /* Always a single row, so the band stays short. */
  .dest__tiles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dest__tile {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--gsv-radius-m);
    color: var(--gsv-white);
  }
  .dest__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dest__cta {
    margin-top: 32px;
    text-align: center;
  }
  @media (max-width: 767px) {
    .dest {
      padding-block: 56px;
    }
    .dest__tiles {
      gap: 6px;
    }
    .dest__tile {
      aspect-ratio: 3 / 4;
      border-radius: var(--gsv-radius-s);
    }
  }
</style>
