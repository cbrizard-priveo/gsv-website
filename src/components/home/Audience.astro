---
// Three photo cards with a frosted label, after Priveo's audience cards.
import type { HomeContent } from '../../data/home';

interface Props {
  content: HomeContent['audience'];
}

const { content } = Astro.props;
---

<section class="gsv-section audience">
  <div class="gsv-container">
    <header class="gsv-section-header">
      <h2 class="gsv-h2">{content.title}</h2>
    </header>
    <ul class="audience__cards">
      {
        content.cards.map((card) => (
          <li>
            <a class="audience__card" href={card.href}>
              <img src={card.image} alt="" loading="lazy" />
              <span class="audience__label">
                <span class="audience__title">{card.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .audience__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .audience__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3.6;
    overflow: hidden;
    border-radius: 20px;
    background: var(--gsv-primary-l-5);
    text-decoration: none;
    isolation: isolate;
  }
  .audience__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
  }
  .audience__card:hover img {
    transform: scale(1.04);
  }
  .audience__label {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 16px 22px 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.66);
    backdrop-filter: blur(10px) saturate(1.4);
  }
  .audience__title {
    color: var(--gsv-primary);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  @media (max-width: 1024px) {
    .audience__cards {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin: 0 auto;
    }
  }
</style>
