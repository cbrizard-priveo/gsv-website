---
// Priveo's callout band (web-priveo-sante: sections/Cta.astro, the « callout-band » layout).
import Icon from '../Icon.astro';
import '../../styles/priveo/sections.css';
import '../../styles/sections.css';

interface Props {
  badge: string;
  title: string;
  text: string;
  cta: { label: string; href: string };
  asideTitle: string;
  items: string[];
  /** Where a fact in the text comes from, shown under it. */
  source?: { prefix: string; label: string; href: string };
  /** A photo: switches to the split layout (photo on one half, text on a deep blue panel). */
  image?: string;
}

const { badge, title, text, cta, asideTitle, items, source, image } = Astro.props;
---

<div class="pv">
{image ? (
<section class="layout-section section callout-media">
  <div class="layout-element layout-container container">
    <div class="callout-media__card">
      <div class="callout-media__photo">
        <img src={image} alt="" loading="lazy" decoding="async" />
      </div>
      <div class="callout-media__body">
        <span class="callout-media__badge">{badge}</span>
        <h2 class="callout-media__title">{title}</h2>
        <p class="callout-media__text">{text}</p>
        {source && <p class="callout-media__source">{source.prefix} <a href={source.href}>{source.label}</a></p>}
        <p class="callout-media__for">{asideTitle}</p>
        <ul class="callout-media__chips">
          {items.map((item) => <li><Icon name="check-circle" /><span>{item}</span></li>)}
        </ul>
        <a class="callout-media__cta" href={cta.href}>{cta.label}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>
) : (
<section class="layout-section section callout-band callout-band--cool">
  <div class="layout-element layout-container container">
    <div class="callout-band__card">
      <div class="callout-band__main">
        <span class="layout-element text-inline badge badge--pill badge-glass callout-band__badge">{badge}</span>
        <h2 class="layout-element typography-heading callout-band__title">{title}</h2>
        <div class="layout-element text-flow callout-band__text"><p>{text}</p>{source && <p class="callout-band__source">{source.prefix} <a href={source.href}>{source.label}</a></p>}</div>
        <a class="action-button btn btn--primary button-base" href={cta.href}>{cta.label}</a>
      </div>
      <aside class="callout-band__aside">
        <p class="callout-band__aside-title">{asideTitle}</p>
        <ul class="callout-band__list">
          {items.map((item) => <li class="callout-band__item"><i class="callout-band__check" aria-hidden="true"><Icon name="check-circle" /></i><span>{item}</span></li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>
)}
</div>
