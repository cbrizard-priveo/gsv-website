---
// Québec's vaccination schedule for children (src/data/calendar.ts) as tables, with the source.
import Icon from '../Icon.astro';
import type { Lang } from '../../data/site';
import { CALENDAR_SOURCE, childCalendar, vaccineColumn } from '../../data/calendar';
import '../../styles/priveo/sections.css';
import '../../styles/sections.css';

interface Props {
  lang: Lang;
  id?: string;
  tagline: string;
  title: string;
  lede?: string;
}

const { lang, id, tagline, title, lede } = Astro.props;
const given = lang === 'fr' ? 'Recommandé' : 'Recommended';
---

<div class="pv">
  <section class="layout-element layout-section section card-section" id={id}>
    <div class="layout-element layout-container container">
      <div class="layout-element layout-stack section-header section-header--center">
        <p class="layout-element text-inline section-header__tagline">{tagline}</p>
        <h2 class="layout-element typography-heading section-header__title font-secondary">{title}</h2>
        {lede && <p class="layout-element text-inline section-header__description">{lede}</p>}
      </div>
      <div class="vax-cal">
        {
          childCalendar.map((table) => (
            <figure class="vax-cal__card">
              <div class="vax-cal__scroll">
                <table>
                  <caption>{table.caption[lang]}</caption>
                  <thead>
                    <tr>
                      <th scope="col">{vaccineColumn[lang]}</th>
                      {table.ages.map((a) => (
                        <th scope="col">{a[lang]}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {table.rows.map((row) => (
                      <tr>
                        <th scope="row">
                          {row.vaccine[lang]}
                          {row.note && '*'}
                        </th>
                        {table.ages.map((_, i) => (
                          <td>
                            {row.at.includes(i) ? (
                              <span class="vax-cal__dose">
                                <Icon name="check-circle" />
                                <span class="vax-cal__sr">{given}</span>
                                {row.when && <span class="vax-cal__when">{row.when[lang]}</span>}
                              </span>
                            ) : (
                              <span class="vax-cal__none" aria-label="—">–</span>
                            )}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="vax-cal__list" aria-hidden="true">
                <p class="vax-cal__list-title">{table.caption[lang]}</p>
                <ul>
                  {table.rows.map((row) => (
                    <li>
                      <strong>
                        {row.vaccine[lang]}
                        {row.note && '*'}
                      </strong>
                      <span>
                        {row.at.map((i, j) => (j ? table.ages[i][lang].replace(/^À /, 'à ').replace(/^At /, 'at ') : table.ages[i][lang])).join(', ')}
                        {row.when && ` (${row.when[lang]})`}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
              {table.note && <figcaption class="vax-cal__note">{table.note[lang]}</figcaption>}
            </figure>
          ))
        }
      </div>
      <div class="service-source">
        <p>
          {lang === 'fr' ? 'Source :' : 'Source:'} <a href={CALENDAR_SOURCE.href[lang]}>{CALENDAR_SOURCE.label[lang]}</a>
        </p>
      </div>
    </div>
  </section>
</div>
