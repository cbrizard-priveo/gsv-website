---
// A service page (Consultation, Vaccination, Prescription, Telemedicine, Companies and groups, Hajj and Umrah) built from Priveo's modules, in
// the order given by src/data/services.ts. Title and description come from the SEO overrides (src/data/seo.ts)
// through BaseLayout, as for the imported pages these replace.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSub from '../components/priveo/HeroSub.astro';
import BookingSteps from '../components/priveo/BookingSteps.astro';
import CalloutBand from '../components/priveo/CalloutBand.astro';
import CardGrid from '../components/priveo/CardGrid.astro';
import ClinicMap from '../components/priveo/ClinicMap.astro';
import Faq from '../components/priveo/Faq.astro';
import PromoBanner from '../components/priveo/PromoBanner.astro';
import LinkTiles from '../components/priveo/LinkTiles.astro';
import { BOOKING, type Lang } from '../data/site';
import { clinicCopy } from '../data/clinics';
import { serviceCopy, type ServicePage } from '../data/services';
import { tarifsCopy, vaccinePrices } from '../data/tarifs';
import { vaccineSeo } from '../data/seo';
import { vaccineList } from '../lib/vaccines';
import { answerHtml, faqCopy, faqJsonLd, type FaqItem } from '../lib/faq';
import { seoFor } from '../data/seo';
import { seoHead } from '../lib/seo';
import { countries, countryPath, formatDate } from '../lib/countries';
import { countryCopy } from '../data/country';

interface Props {
  page: ServicePage;
  lang: Lang;
}

const { page, lang } = Astro.props;
const route = page.route[lang];
const other = page.route[lang === 'fr' ? 'en' : 'fr'];
const seo = seoFor(route);
const t = serviceCopy[lang];
const book = { label: t.book, href: BOOKING };
const steps = clinicCopy[lang].steps;
const money = new Intl.NumberFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', { style: 'currency', currency: 'CAD', minimumFractionDigits: 0 });

// FAQ items by id, from every FAQ file.
const faqFiles = import.meta.glob<{ items: FaqItem[] }>('../data/faq/*.json', { eager: true, import: 'default' });
const faqById = new Map(Object.values(faqFiles).flatMap((f) => f.items.map((i) => [i.id, i] as const)));
const faqItems = (ids: string[]) =>
  ids.map((id) => {
    const item = faqById.get(id);
    if (!item) throw new Error(`service page ${route}: unknown FAQ id ${id}`);
    return { q: item.q[lang], a: answerHtml(item, lang) };
  });
const allFaq = page.blocks.flatMap((b) => (b.type === 'faq' ? faqItems(b.ids) : []));

// Vaccines block: every vaccine page (diseases without a vaccine left out), with its price when listed.
const topics = import.meta.glob<{ routes: Record<Lang, string> }>('../data/vaccines/*.json', { eager: true, import: 'default' });
const topicByRoute = new Map<string, string>([
  ...Object.entries(topics).map(([f, j]) => [j.routes[lang], f.replace(/^.*\/|\.json$/g, '')] as [string, string]),
  [lang === 'fr' ? '/vaccination/rage/' : '/en/vaccination/rabies-vaccination/', 'rage'],
]);
// The cheapest product for a page, and whether Priveo's list adds the visit fee to it (« + prix visite »).
const lowest = (topic?: string) => {
  const rows = vaccinePrices.filter((v) => v.topic === topic || (topic && v.also?.includes(topic))).sort((a, b) => a.price - b.price);
  return rows[0];
};
const vaccineCards = (topics?: string[]) => vaccineList(lang)
  .filter((v) => !vaccineSeo[v.route]?.noVaccine)
  .filter((v) => !topics || topics.includes(topicByRoute.get(v.route) ?? ''))
  .map((v) => {
    const row = lowest(topicByRoute.get(v.route));
    const meta = row ? `${t.price(money.format(row.price))}${row.plusVisit ? ` ${tarifsCopy[lang].vaccines.plusVisit}` : ''}` : undefined;
    return { title: v.name, meta, href: v.route, linkLabel: t.more };
  });

const head = seoHead({
  title: seo?.title ?? page.hero.title[lang],
  description: seo?.description ?? page.hero.description[lang],
  path: route,
  lang,
  alternates: { fr: page.route.fr, en: page.route.en },
  jsonLd: allFaq.length ? faqJsonLd(allFaq) : undefined,
});
---

<BaseLayout lang={lang} htmlLang={lang === 'fr' ? 'fr-CA' : 'en-CA'} title={seo?.title ?? page.hero.title[lang]} head={head} route={route} alt={other}>
  <HeroSub
    tagline={page.hero.tagline[lang]}
    title={seo?.h1 ?? page.hero.title[lang]}
    description={page.hero.description[lang]}
    cta={book}
    image={{ src: page.hero.image.src, alt: page.hero.image.alt[lang], width: page.hero.image.width, height: page.hero.image.height }}
  />
  {
    page.blocks.map((block) => {
      if (block.type === 'steps')
        return <BookingSteps tagline={block.tagline[lang]} title={block.title[lang]} steps={block.steps.map((s) => ({ title: s.title[lang], text: s.text[lang] }))} cta={book} />;
      if (block.type === 'callout')
        return (
          <CalloutBand
            badge={block.badge[lang]}
            title={block.title[lang]}
            text={block.text[lang]}
            cta={{ label: block.cta.label[lang], href: block.cta.href[lang] }}
            asideTitle={block.asideTitle[lang]}
            items={block.items.map((i) => i[lang])}
            source={block.source && { prefix: lang === 'fr' ? 'Source :' : 'Source:', label: block.source.label[lang], href: block.source.href[lang] }}
          />
        );
      if (block.type === 'cards')
        return (
          <CardGrid
            id={block.id}
            tagline={block.tagline?.[lang]}
            title={block.title[lang]}
            lede={block.lede?.[lang]}
            columns={block.columns}
            tone={block.tone}
            cards={block.cards.map((c) => ({ title: c.title[lang], text: c.text[lang], href: c.href?.[lang], linkLabel: c.linkLabel?.[lang], image: c.image }))}
          >
            {block.source && (
              <div class="service-source">
                <p>
                  {lang === 'fr' ? 'Source :' : 'Source:'} <a href={block.source.href[lang]}>{block.source.label[lang]}</a>
                </p>
              </div>
            )}
          </CardGrid>
        );
      if (block.type === 'vaccines') {
        if (block.compact)
          return <LinkTiles id={block.id} tagline={block.tagline[lang]} title={block.title[lang]} lede={block.lede[lang]} links={vaccineCards(block.topics).map((c) => ({ label: c.title, href: c.href }))} />;
        return <CardGrid tagline={block.tagline[lang]} title={block.title[lang]} lede={[block.lede[lang], block.note?.[lang]].filter(Boolean).join(' ')} columns={4} tone="soft" cards={vaccineCards(block.topics)} />;
      }
      if (block.type === 'country') {
        const c = countries.find((x) => x.slug === block.slug);
        if (!c) throw new Error(`service page ${route}: unknown country ${block.slug}`);
        const rows = block.rows.map((id) => {
          const row = [...c.diseases, ...c.otherRisks].find((r) => r.id === id);
          if (!row) throw new Error(`service page ${route}: no row ${id} in ${block.slug}`);
          return { title: row.name[lang], text: row.text[lang] };
        });
        const cc = countryCopy[lang];
        return (
          <CardGrid tagline={block.tagline[lang]} title={block.title[lang]} lede={block.lede[lang]} columns={2} tone="soft" cards={rows}>
            <div class="service-source">
              <p>
                <a class="btn-link" href={countryPath(c, lang)}>{block.all[lang]} →</a>
              </p>
              <p>
                {lang === 'fr' ? 'Source :' : 'Source:'} <a href={c.inspq.url}>{cc.sourceLabel(c.name.fr, formatDate(c.inspq.updated, 'fr'))}</a>. {cc.checked} <time datetime={c.inspq.checked}>{formatDate(c.inspq.checked, lang)}</time>.
              </p>
              <p>{cc.disclaimer}</p>
            </div>
          </CardGrid>
        );
      }
      if (block.type === 'faq') return <Faq title={faqCopy[lang].title} lede={faqCopy[lang].lede} items={faqItems(block.ids)} more={faqCopy[lang].more} />;
      if (block.type === 'banner')
        return <PromoBanner title={block.title[lang]} text={block.text[lang]} cta={{ label: block.cta.label[lang], href: block.cta.href[lang] }} image={block.image} />;
      if (block.type === 'clinics') return <ClinicMap lang={lang} />;
      return <BookingSteps tagline={steps.tagline} title={steps.title} steps={steps.items} cta={book} />;
    })
  }
</BaseLayout>
