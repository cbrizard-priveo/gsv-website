---
// « Tarifs » / "Pricing", in the format of Priveo Santé's price list (priveosante.com/tarifs): a centred
// title, category chips that filter the list, then one group per category with a rounded row per price
// (icon, name, price on the right). Amounts from src/data/tarifs.ts (Priveo Santé's list).
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingSteps from '../components/priveo/BookingSteps.astro';
import Icon from '../components/Icon.astro';
import { BOOKING, type Lang } from '../data/site';
import { clinicCopy } from '../data/clinics';
import { PRICES_CHECKED, consultationPrices, injectionFees, tarifsCopy, vaccinePrices } from '../data/tarifs';
import { vaccineTexts } from '../data/vaccine-texts';
import { seoHead } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = tarifsCopy[lang];
const other = tarifsCopy[lang === 'fr' ? 'en' : 'fr'].path;
// « 40,00 $ » / "$40.00", as on Priveo's list.
const money = new Intl.NumberFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', { style: 'currency', currency: 'CAD', minimumFractionDigits: 2 });
const date = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-CA' : 'en-CA', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${PRICES_CHECKED}T00:00:00Z`));

// Vaccine and disease pages by topic key, to link each vaccine to its page.
const topics = import.meta.glob<{ routes: Record<Lang, string> }>('../data/vaccines/*.json', { eager: true, import: 'default' });
const pageOf: Record<string, string> = Object.fromEntries(Object.entries(topics).map(([f, j]) => [f.replace(/^.*\/|\.json$/g, ''), j.routes[lang]]));
pageOf.rage = lang === 'fr' ? '/vaccination/rage/' : '/en/vaccination/rabies-vaccination/';
if (!vaccineTexts['/vaccination/rage/']) throw new Error('tarifs: rabies page missing');
const steps = clinicCopy[lang].steps;

type Row = { name: string; note?: string; href?: string; price: number; plusVisit?: boolean };
const groups: { id: string; title: string; icon: string; text?: string; rows: Row[] }[] = [
  {
    id: 'consultation',
    title: t.consultation.title,
    icon: 'plane',
    text: t.consultation.text,
    rows: consultationPrices.map((c) => ({ name: c.label[lang], price: c.price })),
  },
  {
    id: 'injection',
    title: t.injection.title,
    icon: 'syringe',
    rows: injectionFees.map((c) => ({ name: c.label[lang], price: c.price })),
  },
  {
    id: 'vaccins',
    title: t.vaccines.title,
    icon: 'syringe',
    text: t.vaccines.text,
    rows: [...vaccinePrices]
      .sort((a, b) => a.disease[lang].localeCompare(b.disease[lang], lang))
      .map((v) => ({ name: v.disease[lang], note: v.product, href: v.topic ? pageOf[v.topic] : undefined, price: v.price, plusVisit: v.plusVisit })),
  },
];

const head = seoHead({
  title: t.seoTitle,
  description: t.description,
  path: t.path,
  lang,
  alternates: lang === 'fr' ? { fr: t.path, en: other } : { fr: other, en: t.path },
  jsonLd: {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: 'Groupe Santé Voyage',
    url: `https://cliniquesantevoyage.com${t.path}`,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: t.title,
      itemListElement: [
        ...consultationPrices.map((c) => ({ '@type': 'Offer', name: `${t.consultation.title} – ${c.label[lang]}`, price: c.price, priceCurrency: 'CAD' })),
        ...vaccinePrices.map((v) => ({ '@type': 'Offer', name: `${v.product} (${v.disease[lang]})`, price: v.price, priceCurrency: 'CAD' })),
      ],
    },
  },
});
---

<BaseLayout lang={lang} htmlLang={lang === 'fr' ? 'fr-CA' : 'en-CA'} title={t.seoTitle} head={head} route={t.path} alt={other}>
  <section class="gsv-section prices" data-prices>
    <div class="gsv-container">
      <header class="prices__head">
        <h1 class="prices__title">{t.title}</h1>
        <p class="prices__lede">{t.lede}</p>
      </header>

      <div class="prices__chips" role="group" aria-label={t.tagline}>
        <button type="button" class="prices__chip" aria-pressed="true" data-chip="">{t.all}</button>
        {groups.map((g) => <button type="button" class="prices__chip" aria-pressed="false" data-chip={g.id}>{g.title}</button>)}
      </div>

      {
        groups.map((g) => (
          <section class="prices__group" data-group={g.id} aria-labelledby={`tarifs-${g.id}`}>
            <h2 class="prices__group-title" id={`tarifs-${g.id}`}>{g.title}</h2>
            {g.text && <p class="prices__group-text">{g.text}</p>}
            <ul class="prices__list">
              {g.rows.map((r) => (
                <li class="prices__row">
                  <span class="prices__icon" aria-hidden="true">
                    <Icon name={g.icon} />
                  </span>
                  <span class="prices__name">
                    {r.href ? <a href={r.href}>{r.name}</a> : r.name}
                    {r.note && <span class="prices__note">{r.note}</span>}
                  </span>
                  <span class="prices__price">
                    {money.format(r.price)}
                    {r.plusVisit && <span class="prices__plus">{t.vaccines.plusVisit}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <aside class="prices__good">
        <h2>{t.good}</h2>
        <p><strong>{t.insurance.title}.</strong> {t.insurance.text}</p>
        <p>
          <a href={t.insurance.faq.href}>{t.insurance.faq.label}<Icon name="arrow-right" /></a>
        </p>
        <p class="prices__checked">{t.checked(date)}</p>
      </aside>
    </div>
  </section>

  <BookingSteps tagline={steps.tagline} title={steps.title} steps={steps.items} cta={{ label: t.book, href: BOOKING }} />
</BaseLayout>

<script>
  // Category chips: show one group, or all of them.
  for (const root of document.querySelectorAll<HTMLElement>('[data-prices]')) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-chip]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const id = chip.dataset.chip;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        for (const g of groups) g.hidden = !!id && g.dataset.group !== id;
      });
    }
  }
</script>

<style>
  .prices {
    padding-top: 72px;
  }
  .prices__head {
    margin-bottom: 32px;
    text-align: center;
  }
  .prices__title {
    color: var(--gsv-primary);
    font: 500 clamp(34px, 4vw, 48px) / 1.1 var(--gsv-font-serif);
    letter-spacing: -0.75px;
  }
  .prices__lede {
    margin-top: 12px;
    font-size: 17px;
  }
  .prices__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 12px;
    margin-bottom: 40px;
  }
  .prices__chip {
    padding: 8px 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--gsv-primary);
    font: 500 16px/1.3 var(--gsv-font-sans);
    cursor: pointer;
  }
  .prices__chip:hover {
    background: var(--gsv-primary-l-6);
  }
  .prices__chip[aria-pressed='true'] {
    background: var(--gsv-primary-l-5);
  }
  .prices__chip:focus-visible {
    outline: 2px solid var(--gsv-primary);
    outline-offset: 2px;
  }
  .prices__group {
    margin-bottom: 40px;
  }
  .prices__group[hidden] {
    display: none;
  }
  .prices__group-title {
    color: var(--gsv-primary);
    font: 500 26px/1.25 var(--gsv-font-sans);
  }
  .prices__group-text {
    margin-top: 6px;
    color: var(--gsv-text-muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .prices__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .prices__row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 24px;
    background: var(--gsv-primary-l-6);
    color: var(--gsv-primary);
  }
  .prices__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--gsv-primary-l-5);
  }
  .prices__icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .prices__name {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
  }
  .prices__name a {
    color: inherit;
    text-decoration: none;
  }
  .prices__name a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prices__note {
    color: var(--gsv-text-muted);
    font-size: 15px;
    font-weight: 400;
  }
  .prices__price {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    font-size: 24px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .prices__plus {
    color: var(--gsv-text-muted);
    font-size: 14px;
    font-weight: 400;
  }
  .prices__good {
    max-width: 760px;
    margin: 56px auto 0;
    padding: 28px 32px;
    border: 1px solid var(--gsv-border-subtle);
    border-radius: 24px;
    background: var(--gsv-white);
    font-size: 15px;
    line-height: 1.6;
  }
  .prices__good h2 {
    margin-bottom: 10px;
    color: var(--gsv-primary);
    font: 500 22px/1.25 var(--gsv-font-serif);
  }
  .prices__good p + p {
    margin-top: 10px;
  }
  .prices__good a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--gsv-primary);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .prices__good a :global(svg) {
    width: 14px;
    height: 14px;
  }
  .prices__checked {
    color: var(--gsv-text-muted);
    font-size: 13px;
  }

  @media (max-width: 767px) {
    .prices {
      padding-top: 48px;
    }
    .prices__chips {
      flex-wrap: nowrap;
      justify-content: flex-start;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .prices__chip {
      flex: none;
      font-size: 15px;
    }
    .prices__group-title {
      font-size: 22px;
    }
    .prices__row {
      gap: 12px;
      padding: 12px 14px;
      border-radius: 18px;
    }
    .prices__icon {
      width: 38px;
      height: 38px;
    }
    .prices__icon :global(svg) {
      width: 19px;
      height: 19px;
    }
    .prices__name {
      font-size: 16px;
    }
    .prices__note {
      font-size: 13px;
    }
    .prices__price {
      font-size: 18px;
    }
    .prices__plus {
      font-size: 12px;
    }
    .prices__good {
      padding: 22px 20px;
    }
  }
</style>
