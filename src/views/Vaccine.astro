---
// A vaccine page in the rebuilt template. Text and SEO tags come from the imported WordPress page.
import BaseLayout from '../layouts/BaseLayout.astro';
import type { WpPageData } from '../layouts/WpPage.astro';
import SubHero from '../components/vaccine/SubHero.astro';
import Article from '../components/vaccine/Article.astro';
import Explorer from '../components/vaccine/Explorer.astro';
import Clinics from '../components/home/Clinics.astro';
import Faq from '../components/priveo/Faq.astro';
import { answerHtml, faqCopy, faqForVaccine, faqJsonLd } from '../lib/faq';
import { home } from '../data/home';
import { BOOKING } from '../data/site';
import { vaccineCopy } from '../data/vaccine';
import { vaccine, vaccineList } from '../lib/vaccines';
import { vaccineSeo, vaccineSeoCopy } from '../data/seo';

interface Props {
  page: WpPageData;
}

const { page } = Astro.props;
const v = await vaccine(page);
const copy = vaccineCopy[page.lang];
const seo = vaccineSeo[page.route];
const t = vaccineSeoCopy[page.lang];
const noVaccine = seo?.noVaccine ?? false;
const where = noVaccine ? t.whereConsult : seo?.where ? t.where(seo.where) : undefined;
const faq = faqForVaccine(page.route).map((i) => ({ q: i.q[page.lang], a: answerHtml(i, page.lang) }));
const head = faq.length ? [...page.head, `<script type="application/ld+json">${JSON.stringify(faqJsonLd(faq)).replace(/</g, '\\u003c')}</script>`] : page.head;
const crumbs = [{ label: copy.home, href: page.lang === 'fr' ? '/' : '/en/' }, copy.section, { label: v.name }];
---

<BaseLayout lang={page.lang} htmlLang={page.htmlLang} title={page.title} head={head} route={page.route} alt={page.alt}>
  <SubHero title={seo?.h1 ?? v.title} served={noVaccine ? t.servedConsult : t.served} lede={v.lede} image={v.image} badge={copy.badge} crumbs={crumbs} crumbsLabel={copy.crumbs} cta={{ label: copy.book, href: BOOKING }} />
  <Article body={v.body} sources={v.sources} copy={copy} lang={page.lang} />
  <Faq title={faqCopy[page.lang].title} lede={faqCopy[page.lang].lede} items={faq} more={faqCopy[page.lang].more} />
  <Explorer copy={copy} vaccines={vaccineList(page.lang)} current={page.route} />
  <Clinics content={home[page.lang].clinics} lang={page.lang} title={where} cta={{ label: noVaccine ? t.bookConsult : t.book, href: BOOKING }} />
</BaseLayout>
