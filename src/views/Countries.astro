---
// Hub of country pages, grouped by region.
import BaseLayout from '../layouts/BaseLayout.astro';
import { countryCopy } from '../data/country';
import type { Lang } from '../data/site';
import { REGIONS, countries, countryPath, hubPath } from '../lib/countries';
import { seoHead } from '../lib/seo';
import Icon from '../components/Icon.astro';
import WorldMap from '../components/WorldMap.astro';
import { BOOKING } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = countryCopy[lang];
const path = hubPath(lang);
const head = seoHead({ title: t.hubSeoTitle, description: t.hubDescription, path, lang, alternates: { fr: hubPath('fr'), en: hubPath('en') } });
const regions = REGIONS.map((r) => ({
  ...r,
  countries: countries.filter((c) => c.region === r.id).sort((a, b) => a.name[lang].localeCompare(b.name[lang], lang)),
})).filter((r) => r.countries.length);
---

<BaseLayout lang={lang} htmlLang={lang === 'fr' ? 'fr-CA' : 'en-CA'} title={t.hubSeoTitle} head={head} route={path} alt={hubPath(lang === 'fr' ? 'en' : 'fr')}>
  <section class="hub-hero">
    <div class="gsv-container">
      <h1 class="gsv-h2">{t.hubTitle}</h1>
      <p class="gsv-lede">{t.hubLede}</p>
      <a class="gsv-button hub-hero__cta" href={BOOKING}>{t.book}<Icon name="arrow-right" /></a>
    </div>
  </section>
  <section class="gsv-section hub">
    <div class="gsv-container hub__map">
      <WorldMap lang={lang} />
    </div>
    <div class="gsv-container hub__regions">
      {
        regions.map((r) => (
          <section class="hub__region" id={r.id}>
            <h2>{r.name[lang]}</h2>
            <ul class="hub__list">
              {r.countries.map((c) => (
                <li>
                  <a href={countryPath(c, lang)}>{c.name[lang]}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero__cta {
    margin-top: 24px;
  }
  .hub-hero {
    padding: 72px 0 56px;
    background: linear-gradient(135deg, var(--gsv-secondary-l-5) 0%, var(--gsv-primary-l-6) 50%, var(--gsv-secondary-l-5) 100%);
  }
  .hub-hero h1 {
    font-size: clamp(36px, 4vw, 52px);
  }
  .hub {
    padding-top: 64px;
  }
  .hub__map {
    margin-bottom: 64px;
  }
  .hub__regions {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .hub__region h2 {
    margin-bottom: 20px;
    color: var(--gsv-primary);
    font: 500 28px/1.2 var(--gsv-font-serif);
  }
  .hub__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .hub__list a {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--gsv-border-subtle);
    border-radius: 14px;
    background: var(--gsv-white);
    color: var(--gsv-primary);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .hub__list a:hover {
    border-color: var(--gsv-secondary-l-4);
    background: var(--gsv-primary-l-6);
  }
</style>
