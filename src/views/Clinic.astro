---
// A clinic page, in the order of Priveo's clinic pages (web-priveo-sante: frames/ClinicFrame.astro):
// hero → contact details, hours and on-site amenities → the care offered there → the booking steps.
// Priveo's « La clinique » presentation needs a longer text than this site has, so it's left out; the
// clinic's access sentence is the hero's description, as Priveo uses the presentation's first sentence.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSub from '../components/priveo/HeroSub.astro';
import ClinicDetail from '../components/priveo/ClinicDetail.astro';
import ServiceGrid from '../components/priveo/ServiceGrid.astro';
import BookingSteps from '../components/priveo/BookingSteps.astro';
import { BOOKING, CLINICS, type Lang } from '../data/site';
import { CLINIC_CONTACT, clinicCopy, clinicPath, type ClinicPage } from '../data/clinics';
import { absolute, seoHead } from '../lib/seo';

interface Props {
  clinic: ClinicPage;
  lang: Lang;
}

const { clinic, lang } = Astro.props;
const t = clinicCopy[lang];
const place = CLINICS[clinic.index];
const path = clinicPath(clinic, lang);
const book = { label: t.book, href: BOOKING };

const head = seoHead({
  title: clinic.title[lang],
  description: clinic.description[lang],
  path,
  lang,
  alternates: { fr: clinicPath(clinic, 'fr'), en: clinicPath(clinic, 'en') },
  image: absolute(clinic.photo),
  jsonLd: {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: `Groupe Santé Voyage – ${clinic.name}`,
    url: absolute(path),
    image: absolute(clinic.photo),
    telephone: `+1-${CLINIC_CONTACT.phone}`,
    faxNumber: `+1-${CLINIC_CONTACT.fax}`,
    email: CLINIC_CONTACT.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: place.address,
      addressLocality: place.locality.replace(/,?\s*[A-Z]\d[A-Z] ?\d[A-Z]\d$/, ''),
      postalCode: place.locality.match(/[A-Z]\d[A-Z] ?\d[A-Z]\d$/)?.[0],
      addressRegion: 'QC',
      addressCountry: 'CA',
    },
    geo: { '@type': 'GeoCoordinates', latitude: clinic.position[0], longitude: clinic.position[1] },
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '16:30',
    },
    parentOrganization: { '@type': 'Organization', name: 'Groupe Santé Voyage', url: absolute(lang === 'fr' ? '/' : '/en/') },
  },
});
---

<BaseLayout lang={lang} htmlLang={lang === 'fr' ? 'fr-CA' : 'en-CA'} title={clinic.title[lang]} head={head} route={path} alt={clinicPath(clinic, lang === 'fr' ? 'en' : 'fr')}>
  <HeroSub tagline={t.clinic.eyebrow} title={clinic.h1[lang]} description={clinic.access[lang]} cta={book} image={{ src: clinic.photo, alt: clinic.name, width: 1280, height: 853 }} />
  <ClinicDetail clinic={clinic} lang={lang} />
  <ServiceGrid name={clinic.short} lang={lang} />
  <BookingSteps tagline={t.steps.tagline} title={t.steps.title} steps={t.steps.items} cta={book} />
</BaseLayout>
