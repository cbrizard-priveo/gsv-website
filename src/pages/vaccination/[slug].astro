---
import Vaccine from '../../views/Vaccine.astro';
import { REBUILT_VACCINES } from '../../lib/rebuilt';
import { vaccinePage } from '../../lib/vaccines';

export function getStaticPaths() {
  return REBUILT_VACCINES.filter((route) => !route.startsWith('/en/')).map((route) => ({
    params: { slug: route.split('/')[2] },
    props: { page: vaccinePage(route)! },
  }));
}

const { page } = Astro.props;
---

<Vaccine page={page} />
